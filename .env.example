# Credenciales del servidor de correo
# Usa una "Contraseña de Aplicación" de Google (no tu contraseña normal)
# https://myaccount.google.com/apppasswords
MAIL_USER=LotlwareSolutions@gmail.com
MAIL_PASS=TU_CONTRASENA_DE_APP

# Puerto del servidor (por defecto 3001)
PORT=3001

# Dominio permitido para CORS (el origen del frontend en producción)
CORS_ORIGIN=http://localhost:5173

# URL base de la API que usa el frontend (VITE_API_URL en el .env del cliente)
VITE_API_URL=http://localhost:3001

# API Key de Google Gemini para el chatbot
GEMINI_API_KEY=tu_api_key_de_google_aqui

